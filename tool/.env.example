# ----------------------------------------------------------------
# 人脈営業ツール — 環境変数テンプレート
# ----------------------------------------------------------------
# 使い方:
#   1. このファイルをコピーして `.env.local` を作成
#   2. 下記の各値を Notion / Anthropic から取得して書き換え
#   3. `.env.local` は .gitignore で除外済み（コミットされない）
# ----------------------------------------------------------------

# Notion Internal Integration Token
# 取得: https://www.notion.so/my-integrations から発行
NOTION_TOKEN=secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 営業候補リスト DB の Data Source ID (32文字)
# 取得: 該当 DB の URL から末尾 32 文字
NOTION_DB_CANDIDATES=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 接触ログ DB の Data Source ID (Phase 2 で新規作成)
NOTION_DB_CONTACT_LOGS=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 間柄 DB の Data Source ID (参照のみ・任意)
NOTION_DB_RELATIONSHIPS=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Anthropic API キー (連絡文作成機能用)
# 取得: https://console.anthropic.com/ から発行
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 使用モデル (デフォルト: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6
